#!/bin/bash
#SBATCH -A durham
#SBATCH -p cosma
#SBATCH --job-name="slurm_alf_Spec"
#SBATCH --time=0-24:00
#SBATCH -D "/cosma5/data/durham/dc-poci1/alf"
#SBATCH --output="/cosma5/data/durham/dc-poci1/alf/slurm_alfSpec.log"
#SBATCH --error="/cosma5/data/durham/dc-poci1/alf/slurm_alfSpec.log"
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=50G
#SBATCH --mail-type=ALL
#SBATCH --mail-user=adriano.poci@durham.ac.uk

module purge
module load gcc/13.2 openmpi python/3.11.4

OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
OMP_PROC_BIND=TRUE
OMP_PLACES=cores


ipython /mnt/extraspace/poci/alf/slurm_alfSpec.py
