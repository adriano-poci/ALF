#!/bin/bash -l
#SBATCH -A oz059
#SBATCH --job-name="alf_NGC4365_SN100"
#SBATCH -D "/fred/oz059/poci/alf/NGC4365"
#SBATCH --time=2-00:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=24
#SBATCH --mem-per-cpu=2200
#SBATCH --mail-type=TIME_LIMIT_90,TIME_LIMIT,FAIL
#SBATCH --mail-user=adriano.poci@physics.ox.ac.uk
#SBATCH --array=0-330

source ${HOME}/.bashrc

module load python-scientific/3.10.8-foss-2022b
export ALF_HOME=/fred/oz059/poci/alf/
export PSM2_CUDA=0

cd ${ALF_HOME}
declare idx=$(printf %04d $((${SLURM_ARRAY_TASK_ID} + 1320)))
mpirun --bind-to core --map-by core ./NGC4365/bin/alf.exe "NGC4365_SN100_${idx}" 2>&1 | tee -a "NGC4365/out_${idx}.log"
