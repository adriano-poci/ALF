#!/bin/bash -l
#SBATCH -A oz059
#SBATCH --job-name="alf_NGC4365_SN100_aperture"
#SBATCH -D "/fred/oz059/poci/alf/NGC4365"
#SBATCH --time=2-00:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=24
#SBATCH --mem-per-cpu=2200
#SBATCH --mail-type=TIME_LIMIT_90,TIME_LIMIT,FAIL
#SBATCH --mail-user=adriano.poci@students.mq.edu.au
#SBATCH -o "/fred/oz059/poci/alf/NGC4365/out.log" # Standard out to galaxy
#SBATCH -e "/fred/oz059/poci/alf/NGC4365/out.log" # Standard err to galaxy
#SBATCH --open-mode=append

source ${HOME}/.bashrc

module load python-scientific/3.10.8-foss-2022b
export ALF_HOME=/fred/oz059/poci/alf/
export PSM2_CUDA=0

### Compile clean version of `alf`
cd ${ALF_HOME}src
cp alf.perm.f90 alf.f90
## Set fallback value to systemic velocity of the galaxy
# Replace the placeholder value in `sed` script
cp ${ALF_HOME}NGC4365/alf_replace.sed ${ALF_HOME}NGC4365/alf_replace.tmp
sed -i "s/velz = 999/velz = 1244.7500000000227/g" ${ALF_HOME}NGC4365/alf_replace.tmp
# Run `sed` using the multi-line script
# Pipe to temporary file
sed -n -f ${ALF_HOME}NGC4365/alf_replace.tmp alf.f90 >> alf_tmp.f90
mv alf_tmp.f90 alf.f90
rm ${ALF_HOME}NGC4365/alf_replace.tmp
# Remove prior placeholders on velz
sed -i "s/prlo%velz = -999.0/prlo%velz = 934.0466881173033/g" alf.f90
sed -i "s/prhi%velz = 999.0/prhi%velz = 1555.1316339763316/g" alf.f90
sed -i "s/velz=9999/velz=1219.8550000000223)/g" alf.f90
make clean && make all && make clean

cd ${ALF_HOME}
[[ ! -d NGC4365/bin ]] && mkdir -p NGC4365/bin
rm NGC4365/bin/*
cp bin/* NGC4365/bin/
# Run aperture fit
mpirun --bind-to core --map-by core ./NGC4365/bin/alf.exe "NGC4365_SN100_aperture" 2>&1 | tee -a "NGC4365/out_aperture.log"

# Read in the aperture fit
Ipy='ipython --pylab --pprint --autoindent'
galax='NGC4365'
SN=100
pythonOutput=$($Ipy alf_aperRead.py -- -g "$galax" -sn "$SN" -dc "")
echo "$pythonOutput" 2>&1 | tee -a "NGC4365/out_aperture.log"
# Temporary variable for the last line of the Python output
readarray -t tmp <<< $(echo "$pythonOutput" | tail -n1)
# Transform into bash array
IFS=',' read -ra aperKin <<< "$tmp"
echo "${aperKin[*]}" 2>&1 | tee -a "NGC4365/out_aperture.log"

### Compile modified velocity priors
cd ${ALF_HOME}src
cp alf.perm.f90 alf.f90
# `bc` arithmetic to define the lower and upper velocity bounds
newVLo=$(bc -l <<< "(${aperKin[0]} - ${aperKin[1]}) - 10.0 * (${aperKin[2]} + ${aperKin[3]})")
newVHi=$(bc -l <<< "(${aperKin[0]} + ${aperKin[1]}) + 10.0 * (${aperKin[2]} + ${aperKin[3]})")
sed -i "s/prlo%velz = -999.0/prlo%velz = ${newVLo}/g" alf.f90
sed -i "s/prhi%velz = 999.0/prhi%velz = ${newVHi}/g" alf.f90
sed -i "s/velz=9999/velz=1219.8550000000223)/g" alf.f90
# Replace the placeholder value in `sed` script
sed -i "s/velz = 999/velz = ${aperKin[0]}/g" ${ALF_HOME}NGC4365/alf_replace.sed
# Run `sed` using the multi-line script
# Pipe to temporary file
sed -n -f ${ALF_HOME}NGC4365/alf_replace.sed alf.f90 >> alf_tmp.f90
mv alf_tmp.f90 alf.f90

make clean && make all && make clean

# Move executables to local directory
cd ${ALF_HOME}
cp bin/* NGC4365/bin/
find "NGC4365" -name "alf*.qsys" -type f -exec sbatch {} \;
