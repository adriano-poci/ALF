#!/bin/bash -l
# #SBATCH -A durham
# #SBATCH -p cosma
#SBATCH -p long
#SBATCH --job-name="alf"
#SBATCH --time=0-72:00
#SBATCH -D "/data/phys-gal-dynamics/phys2603/alf"
# #SBATCH --job-name="alf_NGC4365_SN100_aperture"
# #SBATCH -D "/cosma5/data/durham/dc-poci1/alf/NGC4365"
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=24
#SBATCH --mem-per-cpu=2400
#SBATCH --mail-type=TIME_LIMIT_90,TIME_LIMIT,FAIL
#SBATCH --mail-user=adriano.poci@physics.ox.ac.uk
# #SBATCH -o "/cosma5/data/durham/dc-poci1/alf/NGC4365/out.log" # Standard out to galaxy
# #SBATCH -e "/cosma5/data/durham/dc-poci1/alf/NGC4365/out.log" # Standard err to galaxy
#SBATCH -o "/data/phys-gal-dynamics/phys2603/alf/out.log" # Standard out to galaxy
#SBATCH -e "/data/phys-gal-dynamics/phys2603/alf/out.log" # Standard err to galaxy
# #SBATCH --open-mode=append

# ------------------------------------------------------------------------------
# Usage:
# sbatch oneSpec.qsys -s "SNL1_NFMESOouter_1arcs_dust"
# ------------------------------------------------------------------------------

source ${HOME}/.bashrc

#############
# ARC #######
#############
# module purge
# module load Anaconda3/2024.02-1 foss/2023a
# export OMPI_MCA_btl=^openib
# export ALF_HOME=/data/phys-gal-dynamics/phys2603/alf/

#############
# Glamdring #
#############
module purge
module load gcc/13.2
module load openmpi
module load python/3.11.4
export ALF_HOME=/mnt/extraspace/poci/alf/
export PSM2_CUDA=0
export PMIX_MCA_gds=hash

# Defaults
spectrum=""
galaxy=""
ncpu=''

while getopts ":s:g:n:" arg; do
  case $arg in
    s) spectrum=$OPTARG ;;
    g) galaxy=$OPTARG  ;;
    n) ncpu=$OPTARG ;;
  esac
done

ncpu=${ncpu:-$SLURM_CPUS_PER_TASK}

# ### Compile clean version of `alf`
# cd ${ALF_HOME}src
# cp alf.perm.f90 alf.f90
# # Remove prior placeholders on velz
# sed -i "/prlo%velz = -999./d" alf.f90
# sed -i "/prhi%velz = 999./d" alf.f90
# make clean && make all && make clean
cd ${ALF_HOME}
# exit
# Run aperture fit

mpirun --oversubscribe -np ${ncpu} ${ALF_HOME}${galaxy}/bin/alf.exe "$spectrum" 2>&1 | tee -a "$spectrum.log"
  # 