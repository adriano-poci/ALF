#!/bin/bash -l
#SBATCH -p cmb
#SBATCH --job-name="alf_stacked_KMeans_0"
#SBATCH -D "/data/phys-gal-dynamics/phys2603/alf"
#SBATCH --time=01-00:00
#SBATCH --nodes=1
#SBATCH --ntasks=16
#SBATCH --mem-per-cpu=2400
#SBATCH --mail-type=TIME_LIMIT_90,TIME_LIMIT,FAIL
#SBATCH --mail-user=adriano.poci@physics.ox.ac.uk
#SBATCH -o "/mnt/extraspace/poci/alf/out.log" # Standard out to galaxy
#SBATCH -e "/mnt/extraspace/poci/alf/out.log" # Standard err to galaxy
#SBATCH --open-mode=append

source ${HOME}/.bashrc

module load gcc/13.2
module load openmpi
module load python/3.11.4
export ALF_HOME=/mnt/extraspace/poci/alf/
### Compile clean version of `alf`
cd ${ALF_HOME}
# Run aperture fit
mpirun --bind-to core --map-by core ./bin/alf.exe "stacked_KMeans_0" 2>&1 | tee -a "stacked_KMeans_0.log"

