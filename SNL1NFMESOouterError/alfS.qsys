#!/bin/bash -l
#SBATCH -A durham
#SBATCH -p cosma5
#SBATCH -D "/cosma5/data/durham/dc-poci1/alf/SNL1NFMESOouterError"
#SBATCH --time=0-48:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=24
#SBATCH --mem-per-cpu=2200
#SBATCH --mail-type=TIME_LIMIT_90,TIME_LIMIT,FAIL
#SBATCH --mail-user=adriano.poci@students.mq.edu.au

source ${HOME}/.bashrc

module load gnu_comp/9.3.0
module load openmpi/4.1.4
module load python/3.10.7
module load cmake/3.18.1
export ALF_HOME=/cosma5/data/durham/dc-poci1/alf/
export PSM2_CUDA=0

cd ${ALF_HOME}
while getopts ":d:" arg; do
    case $arg in
        d) idx=$OPTARG;;
    esac
done

declare pidx=$(printf %04d ${idx})
mpirun --bind-to core --map-by core ./SNL1NFMESOouterError/bin/alf.exe "SNL1_SN80_${pidx}" 2>&1 | tee -a "SNL1NFMESOouterError/out_${pidx}.log"
